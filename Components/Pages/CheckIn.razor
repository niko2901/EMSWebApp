@page "/checkin"
@attribute [Authorize]

@using EMSWebApp.Data
@using EMSWebApp.Models
@using EMSWebApp.Models.ModelEnums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<AppDbContext> DbFactory

@rendermode InteractiveServer

<style>
	/* Default outlined state */
	.btn-session {
		color: #4f46e5;
		border-color: #4f46e5;
		background-color: transparent;
		transition: all 0.2s ease-in-out;
	}

		.btn-session:hover {
			color: #ffffff;
			background-color: #4338ca;
			border-color: #4338ca;
		}

	/* Active / Checked state */
	.btn-check:checked + .btn-session {
		color: #ffffff !important;
		background-color: #4f46e5 !important;
		border-color: #4f46e5 !important;
	}

	video {
		width: 100% !important;
		height: 100% !important;
		object-fit: cover !important;
		transform: translateZ(0); /* Hardware acceleration hook */
		will-change: transform;
	}
</style>

<div data-bs-theme="dark" class="d-flex flex-column min-vh-100 w-100 align-items-center bg-body text-body pb-5">
	@* Top Bar *@
	<div class="w-100 d-flex justify-content-center align-items-center p-3 mb-4 shadow-sm" style="background-color: #6A7EFC;">
		<h5 class="fw-bold text-white mb-0">QR Check-In</h5>
	</div>

	<div class="w-100 d-flex flex-column gap-3 px-3" style="max-width: 27rem;">
		<div class="w-100">
			<label class="form-label">Select Event</label>
			<InputSelect @bind-Value="eventSelected" @bind-Value:after="clearForm" class="form-select col-12 rounded-3" >
				<option value="@Guid.Empty" selected>Choose Event</option>
				@foreach(var item in userEvents)
				{
					<option value="@item.Id">@item.Name</option>
				}
			</InputSelect>
		</div>

		<div class="btn-group w-100" role="group" aria-label="Check-in session selector">
			<input type="radio" class="btn-check" name="sessionRadio" id="amRadio"
				checked="@(activeSession == CheckInSession.AM)"
				@onchange="() => activeSession = CheckInSession.AM" />
			<label class="btn btn-session fw-semibold" for="amRadio">Morning (AM)</label>

			<input type="radio" class="btn-check" name="sessionRadio" id="pmRadio"
				checked="@(activeSession == CheckInSession.PM)"
				@onchange="() => activeSession = CheckInSession.PM" />
			<label class="btn btn-session fw-semibold" for="pmRadio">Afternoon (PM)</label>
		</div>

		@if(eventSelected != Guid.Empty)
		{
			<div class="card p-4 rounded-4 shadow-sm">
				<div class="border border-secondary-subtle rounded-3 d-flex flex-column align-items-center justify-content-center overflow-hidden bg-black position-relative" style="height: 15rem;">
					<div class="w-100 h-100 @(isScanned ? "d-none" : "d-flex align-items-center justify-content-center")">
						<Scanner CodeFound="CodeFound" @ref="_scannerRef" AutoStart="true" />
					</div>

					@if (isScanned && isScannedSuccess)
					{
						<div class="d-flex flex-column align-items-center justify-content-center p-3 text-center">
							<svg xmlns="http://www.w3.org/2000/svg" width="70" height="70" fill="#0eb557" class="bi bi-check2-square mb-2" viewBox="0 0 16 16">
								<path d="M3 14.5A1.5 1.5 0 0 1 1.5 13V3A1.5 1.5 0 0 1 3 1.5h8a.5.5 0 0 1 0 1H3a.5.5 0 0 0-.5.5v10a.5.5 0 0 0 .5.5h10a.5.5 0 0 0 .5-.5V8a.5.5 0 0 1 1 0v5a1.5 1.5 0 0 1-1.5 1.5z" />
								<path d="m8.354 10.354 7-7a.5.5 0 0 0-.708-.708L8 9.293 5.354 6.646a.5.5 0 1 0-.708.708l3 3a.5.5 0 0 0 .708 0" />
							</svg>
							<span class="fw-bold text-success">Checked-in Successfully</span>
						</div>
					}
					else if (isScanned && !isScannedSuccess)
					{
						<div class="d-flex flex-column align-items-center justify-content-center p-3 text-center">
							<svg xmlns="http://www.w3.org/2000/svg" width="70" height="70" fill="#c41616" class="bi bi-x-square mb-2" viewBox="0 0 16 16">
								<path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z" />
								<path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708" />
							</svg>
							<span class="fw-bold text-danger">Check-in Invalid</span>
						</div>
					}
				</div>

				<button type="button" class="btn btn-primary rounded-3 mt-3 w-100" @onclick="scanStart">
					<i class="bi bi-arrow-repeat me-1"></i> Rescan
				</button>
			</div>

			<div class="card rounded-4 shadow-sm">
				<div class="card-body p-4 pt-3">
					<EditForm Model="qrModel" OnValidSubmit="HandleSubmit">
						<label for="code" class="form-label fw-semibold small text-secondary">Enter Code Manually</label>
						<div class="d-flex gap-2">
							<InputText class="form-control rounded-3" @bind-Value="qrModel!.code" id="code" placeholder="Enter QR code / ID" autocomplete="off" />
							<button type="submit" class="btn btn-outline-light flex-shrink-0 rounded-3 px-3">Check in</button>
						</div>

						@if (!string.IsNullOrEmpty(statusMessage))
						{
							<div class="alert @(isErr ? "alert-danger" : "alert-success") py-2 mt-3 mb-0 text-center rounded-3 small" role="alert">
								@statusMessage
							</div>
						}
					</EditForm>
				</div>
			</div>
		}
	</div>

</div>

@code {
	private Guid eventSelected;

	private string _code = string.Empty;
	private string? statusMessage;
	private string? sysErr;

	private bool isScanned = false;
	private bool isScannedSuccess = false;
	private bool isErr = true;

	private QRModel qrModel = new();
	private Scanner _scannerRef = default!;
	private CheckInSession activeSession = CheckInSession.AM;

	private List<EventDropdownDTO> userEvents = new();

	protected override async Task OnInitializedAsync()
	{
		using var Db = await DbFactory.CreateDbContextAsync();

		userEvents = await Db.UserEvents
			.AsNoTracking()
			.OrderByDescending(e => e.StartDate)
			.Select(e => new EventDropdownDTO { Id = e.Id, Name = e.Name })
			.ToListAsync();
	}

	private async Task CodeFound(string code)
	{
		if (_scannerRef is not null)
		{
			await _scannerRef.Stop();
		}
		_code = code;
		qrModel.code = code;
		await ProcessCheckInCore(code);
	}

	private async Task HandleSubmit()
	{
		if (string.IsNullOrEmpty(qrModel.code))
			return;

		await ProcessCheckInCore(qrModel.code);
	}

	private async Task ProcessCheckInCore(string rawCode)
	{
		isScanned = true;
		sysErr = null;

		if (!Guid.TryParse(rawCode.Trim(), out Guid scannedId))
		{
			SetFailure("Invalid QR Format. Code must be a valid ID.");
			return;
		}

		if (eventSelected == Guid.Empty)
		{
			SetFailure("Please select an event first.");
			return;
		}

		try
		{
			using var db = await DbFactory.CreateDbContextAsync();

			var record = await db.Registered
				.Where(r => r.EventId == eventSelected && r.Id == scannedId)
				.FirstOrDefaultAsync();

			if (record == null)
			{
				SetFailure("Ticket not found for this event.");
				return;
			}

			var now = DateTime.UtcNow;

			if (activeSession == CheckInSession.AM)
			{
				if (record.CheckInDate.HasValue)
				{
					SetFailure($"{record.FullName} already checked in for AM at {record.CheckInDate.Value.ToLocalTime():hh:mm tt}.");
					return;
				}
				record.CheckInDate = now;
			}
			else
			{
				if (record.CheckInDate2.HasValue)
				{
					SetFailure($"{record.FullName} already checked in for PM at {record.CheckInDate2.Value.ToLocalTime():hh:mm tt}.");
					return;
				}
				record.CheckInDate2 = now;
			}

			record.StatusId = 4;

			await db.SaveChangesAsync();

			isScannedSuccess = true;
			isErr = false;
			statusMessage = $"✅ {record.FullName} checked in for {activeSession} session at {now.ToLocalTime():hh:mm tt}!";
		}
		catch (Exception ex)
		{
			sysErr = ex.Message;
			SetFailure("System error recording check-in.");
		}
	}

	private void SetFailure(string message)
	{
		isScannedSuccess = false;
		isErr = true;
		statusMessage = message;
	}

	private async Task scanStart()
	{
		isScanned = false;
		clearForm();

		if (_scannerRef is not null)
		{
			await _scannerRef.Start();
		}
	}

	private void clearForm()
	{
		qrModel.code = string.Empty;
		statusMessage = null;
		sysErr = null;
		isErr = false;
		isScanned = false;
		isScannedSuccess = false;
	}

	public enum CheckInSession
	{
		AM,
		PM
	}

	public class QRModel{
		public string code { get; set; } = string.Empty;
	}

	public class EventDropdownDTO {
		public Guid Id { get; set; }
		public string Name { get; set; } = string.Empty;
	}
}
