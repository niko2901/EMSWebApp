@page "/checkin"
@attribute [Authorize]

@using EMSWebApp.Data
@using EMSWebApp.Models
@using EMSWebApp.Models.ModelEnums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<AppDbContext> DbFactory

@rendermode InteractiveServer

<div data-bs-theme="dark" class="d-flex flex-column min-vh-100 w-100 align-items-center bg-body text-body gap-4">
	<div class="w-100 d-flex justify-content-center p-3 mb-3" style="background-color: #6A7EFC;">
		<h5 class="fw-bold">QR Check-In</h5>
	</div>

	<div class="w-100 d-flex px-3" style="max-width: 27rem;">
		<div class="w-100">
			<label class="form-label">Select Event</label>
			<InputSelect @bind-Value="eventSelected" @bind-Value:after="clearForm" class="form-select col-12 rounded-3" >
				<option value="@Guid.Empty" selected>Choose Event</option>
				@foreach(var item in userEvents)
				{
					<option value="@item.Id">@item.Name</option>
				}
			</InputSelect>
		</div>
	</div>

	@if(eventSelected != Guid.Empty)
	{
		<div class="w-100 d-flex px-3" style="max-width: 27rem;">
			<div class="card w-100 p-4 rounded-4 gap-3">
				<div class="card rounded-4 align-items-center justify-content-center overflow-hidden" style="height: 15rem;">
					<div class="w-100 h-100 @(isScanned ? "d-none" : "d-flex align-items-center justify-content-center")" style="max-height:100%; max-width:100%;">
						<Scanner CodeFound="CodeFound" @ref="_scannerRef" AutoStart="true"/>
					</div>
					@if (isScanned && isScannedSuccess)
					{
						<svg xmlns="http://www.w3.org/2000/svg" color="#0eb557" width="85" height="85" fill="currentColor" class="bi bi-check2-square" viewBox="0 0 16 16">
							<path d="M3 14.5A1.5 1.5 0 0 1 1.5 13V3A1.5 1.5 0 0 1 3 1.5h8a.5.5 0 0 1 0 1H3a.5.5 0 0 0-.5.5v10a.5.5 0 0 0 .5.5h10a.5.5 0 0 0 .5-.5V8a.5.5 0 0 1 1 0v5a1.5 1.5 0 0 1-1.5 1.5z" />
							<path d="m8.354 10.354 7-7a.5.5 0 0 0-.708-.708L8 9.293 5.354 6.646a.5.5 0 1 0-.708.708l3 3a.5.5 0 0 0 .708 0" />
						</svg>
						<p>Checked-in Successfully</p>
					}
					else if (isScanned && !isScannedSuccess)
					{
						<svg xmlns="http://www.w3.org/2000/svg" color="#c41616" width="85" height="85" fill="currentColor" class="bi bi-x-square" viewBox="0 0 16 16">
							<path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z" />
							<path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708" />
						</svg>
						<p>Check-in Invalid</p>
					}
				</div>
				<button class="btn btn-primary" @onclick="scanStart">Rescan</button>
			</div>
		</div>

		<div class="w-100 px-3" style="max-width: 27rem;">
			<div class="card rounded-4">
				<div class="card-body">
					<EditForm Model="qrModel" OnValidSubmit="HandleSubmit">
						<label for="code" class="form-label">Enter Code Manually</label>
						<div class="d-flex gap-2">
							<InputText class="form-control rounded-3" @bind-Value="qrModel!.code" id="code" placeholder="Enter QR code" autocomplete="off" />
							<button type="submit" class="btn btn-secondary flex-shrink-0 rounded-3">Check in</button>
						</div>
						@if (!string.IsNullOrEmpty(statusMessage))
						{
							<p class="alert @(isErr ? "alert-danger" : "alert-success") py-2 mt-2 text-center px-2">@statusMessage</p>
						}
					</EditForm>
				</div>
			</div>
		</div>
	}
</div>

@code {
	private Guid eventSelected;
	private QRModel qrModel = new();
	private string? statusMessage;
	private bool isErr = true;
	private string? sysErr;
	private List<UserEvent> userEvents = new();
	private List<Registered> registerUser = new();
	private Scanner _scannerRef = default!;
	private string _code = string.Empty;
	private bool isScanned = false;
	private bool isScannedSuccess = false;

	protected override async Task OnInitializedAsync()
	{
		using var Db = await DbFactory.CreateDbContextAsync();
		userEvents = await Db.UserEvents.ToListAsync();
	}

	private async Task HandleSubmit()
	{
		if (string.IsNullOrEmpty(qrModel.code))
		{
			return;
		}

		if (Guid.TryParse(qrModel.code, out Guid scannedId))
		{
			using var Db = await DbFactory.CreateDbContextAsync();
			var registration = await Db.Registered.Where(r => (r.StatusId == 2 || r.StatusId == 4) && r.UserEvent!.Id == eventSelected).FirstOrDefaultAsync(r => r.Id == scannedId);

			if(registration?.StatusId == 4)
			{
				isErr = true;
				statusMessage = $"{registration.FullName} already checked-in at {registration.CheckInDate?.ToLocalTime().ToString("hh:mm tt")}";
				return;
			}
			if (registration == null)
			{
				isErr = true;
				statusMessage = "Invalid code. Ticket not found.";
				return;
			}

			try
			{
				registration.StatusId = 4;
				registration.CheckInDate = DateTime.UtcNow;

				var res = await Db.SaveChangesAsync();

				if (res > 0)
				{
					isErr = false;
					statusMessage = $"{registration.FullName} successfully checked-in at {registration.CheckInDate.Value.ToLocalTime().ToString("hh:mm tt")}.";
				}

			}
			catch(Exception ex)
			{
				sysErr = ex.Message;
			}
		}
		else
		{
			isErr = true;
			statusMessage = "Code Invalid.";
		}
	}

	private void clearForm()
	{
		qrModel = new QRModel()
		{
			code = string.Empty
		};
		statusMessage = null;
	}

	private async Task CodeFound(string code)
	{
		_code = code;
		isScanned = true;

		if (Guid.TryParse(code, out Guid scannedId))
		{
			using var Db = await DbFactory.CreateDbContextAsync();
			var registration = await Db.Registered.Where(r => (r.StatusId == 2 || r.StatusId == 4) && r.UserEvent!.Id == eventSelected).FirstOrDefaultAsync(r => r.Id == scannedId);

			if (registration?.CheckInDate != null)
			{
				isErr = true;
				statusMessage = $"{registration.FullName} already checked-in at {registration.CheckInDate?.ToLocalTime().ToString("hh:mm tt")}";
				return;
			}
			if (registration == null)
			{
				isErr = true;
				statusMessage = "Invalid code. Ticket not found.";
				return;
			}

			try
			{
				registration.StatusId = 4;
				registration.CheckInDate = DateTime.UtcNow;

				var res = await Db.SaveChangesAsync();

				if (res > 0)
				{
					isScannedSuccess = true;
					isErr = false;
					statusMessage = $"{registration.FullName} successfully checked-in at {registration.CheckInDate.Value.ToLocalTime().ToString("hh:mm tt")}.";
				}

			}
			catch (Exception ex)
			{
				sysErr = ex.Message;
			}
		}
		else
		{
			isScannedSuccess = false;
			isErr = true;
			statusMessage = "Code Invalid.";
		}
	}

	private async Task scanStart()
	{
		isScanned = false;
		clearForm();

		if (_scannerRef is not null)
		{
			await _scannerRef.Start();
		}
	}

	public class QRModel{
		public string code { get; set; } = string.Empty;
	}
}
