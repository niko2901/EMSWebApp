@page "/checkin"
@attribute [Authorize]

@using EMSWebApp.Data
@using EMSWebApp.Models
@using EMSWebApp.Models.ModelEnums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore

@inject AppDbContext Db

@rendermode InteractiveServer

<style>
	input.valid.modified,
	.form-control.valid,
	.valid.modified:not([type=checkbox]) {
		box-shadow: none;
		outline-color: transparent;
	}

</style>

<div data-bs-theme="dark" class="d-flex flex-column min-vh-100 w-100 align-items-center bg-body text-body gap-4">
	<div class="w-100 d-flex justify-content-center p-3 mb-3" style="background-color: #6A7EFC;">
		<h5 class="fw-bold">QR Check-In</h5>
	</div>

	<div class="w-100 d-flex" style="max-width: 27rem;">
		<div class="w-100">
			<label class="form-label">Select Event</label>
			<InputSelect @bind-Value="eventSelected" @bind-Value:after="clearForm" class="form-select col-12 rounded-3" >
				<option value="@Guid.Empty" selected>Choose Event</option>
				@foreach(var item in userEvents)
				{
					<option value="@item.Id">@item.Name</option>
				}
			</InputSelect>
		</div>
	</div>

	@if(eventSelected != Guid.Empty)
	{
		<div class="w-100 d-flex" style="max-width: 27rem;">
			<div class="card w-100 p-4 rounded-4 gap-3">
				<div class="card rounded-4 p-4 align-items-center justify-content-center" style="height: 15rem;">
					<svg xmlns="http://www.w3.org/2000/svg" opacity="60%" width="80" height="80" fill="currentColor" class="bi bi-qr-code-scan" viewBox="0 0 16 16">
						<path d="M0 .5A.5.5 0 0 1 .5 0h3a.5.5 0 0 1 0 1H1v2.5a.5.5 0 0 1-1 0zm12 0a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 .5.5v3a.5.5 0 0 1-1 0V1h-2.5a.5.5 0 0 1-.5-.5M.5 12a.5.5 0 0 1 .5.5V15h2.5a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5v-3a.5.5 0 0 1 .5-.5m15 0a.5.5 0 0 1 .5.5v3a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1 0-1H15v-2.5a.5.5 0 0 1 .5-.5M4 4h1v1H4z" />
						<path d="M7 2H2v5h5zM3 3h3v3H3zm2 8H4v1h1z" />
						<path d="M7 9H2v5h5zm-4 1h3v3H3zm8-6h1v1h-1z" />
						<path d="M9 2h5v5H9zm1 1v3h3V3zM8 8v2h1v1H8v1h2v-2h1v2h1v-1h2v-1h-3V8zm2 2H9V9h1zm4 2h-1v1h-2v1h3zm-4 2v-1H8v1z" />
						<path d="M12 9h2V8h-2z" />
					</svg>
				</div>
				<p class="text-center text-muted" style="font-size: .86rem;">QR scanning will be implemented once other functionality and qr maker is implemented</p>
			</div>
		</div>

		<div class="w-100" style="max-width: 27rem;">
			<div class="card rounded-4">
				<div class="card-body">
					<EditForm Model="qrModel" OnValidSubmit="HandleSubmit">
						<label for="code" class="form-label">Enter Code Manually</label>
						<div class="d-flex gap-2">
							<InputText class="form-control rounded-3" @bind-Value="qrModel!.code" id="code" placeholder="Enter QR code" autocomplete="off" />
							<button type="submit" class="btn btn-secondary flex-shrink-0 rounded-3">Check in</button>
						</div>
						@if (!string.IsNullOrEmpty(statusMessage))
						{
							<p class="alert @(isErr ? "alert-danger" : "alert-success") py-1 mt-1">@statusMessage</p>
						}
					</EditForm>
				</div>
			</div>
		</div>
	}
</div>

@code {
	private Guid eventSelected;
	private QRModel qrModel = new();
	private string? statusMessage;
	private bool isErr = true;
	private string? sysErr;
	private List<UserEvent> userEvents = new();
	private List<Registered> registerUser = new();

	protected override async Task OnInitializedAsync()
	{
		userEvents = await Db.UserEvents.ToListAsync();
	}

	private async Task HandleSubmit()
	{
		if (string.IsNullOrEmpty(qrModel.code))
		{
			return;
		}

		if (Guid.TryParse(qrModel.code, out Guid scannedId))
		{
			var registration = await Db.Registered.Where(r => (r.StatusId == 2 || r.StatusId == 4) && r.UserEvent!.Id == eventSelected).FirstOrDefaultAsync(r => r.Id == scannedId);

			if(registration?.StatusId == 4)
			{
				isErr = true;
				statusMessage = $"User already checked-in at {registration.CheckInDate?.ToLocalTime().ToString("hh:mm tt")}";
				return;
			}
			if (registration == null)
			{
				isErr = true;
				statusMessage = "Invalid code. Ticket not found.";
				return;
			}

			try
			{
				registration.StatusId = 4;
				registration.CheckInDate = DateTime.UtcNow;

				await Db.SaveChangesAsync();

				isErr = false;
				statusMessage = "User successfully checked-in.";

			}
			catch(Exception ex)
			{
				sysErr = ex.Message;
			}
		}
		else
		{
			isErr = true;
			statusMessage = "Code Invalid.";
		}
	}

	private void clearForm()
	{
		qrModel = new QRModel()
		{
			code = string.Empty
		};
		statusMessage = null;
	}

	public class QRModel{
		public string code { get; set; } = string.Empty;
	}
}
