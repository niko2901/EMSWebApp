@page "/registrations"
@attribute [Authorize]

@using Microsoft.EntityFrameworkCore
@using EMSWebApp.Models.ModelEnums
@using EMSWebApp.Models
@using EMSWebApp.Data
@using EMSWebApp.Services
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authorization
@implements IDisposable

@inject IDbContextFactory<AppDbContext> DbFactory

@rendermode InteractiveServer

<PageTitle>Registrations</PageTitle>

<div class="d-flex flex-column align-items-center w-100 py-3">
	<div class="w-100 px-3 d-flex flex-column gap-3" style="max-width: 80rem;">
		<div>
			<h4 class="fw-bold">Registrations</h4>
			<p>@registerCount records</p>
		</div>

		<div class="row g-2">
			@* input search registered users  *@
			<div class="col-12 col-md-8">
				<input type="text" value="@searchUser" @oninput="FilterList" class="form-control" placeholder="Search Name..."/>	
			</div>

			<div class="col-6 col-md-2">
				<InputSelect @bind-Value="eventId" @bind-Value:after="FilterByEvent" class="form-select">
					<option value="@Guid.Empty" selected>All Events</option>
					@foreach(var events in userEvents)
					{
						<option value="@events.Id">@events.Name</option>
					}
				</InputSelect>
			</div>

			<div class="col-6 col-md-2">
				<InputSelect @bind-Value="regStatusId" @bind-Value:after="FilterByEvent" class="form-select">
					<option value="">All Status</option>
					@foreach (var stats in regStatus)
					{
						<option value="@stats.Id">@stats.Name</option>
					}
				</InputSelect>
			</div>
		</div>

		<div class="overflow-auto rounded-4">
			<QuickGrid Items="@filteredUser.AsQueryable()" Pagination="@pagination" Class="table table-hover align-middle m-0">
				<TemplateColumn Title="Attendee" Class="px-3 py-2 text-muted">
					<div>
						<p style="font-size: 0.875rem; font-weight: 500;">@context.FullName</p>
						<p class="text-muted" style="font-size: .79rem; font-weight: 500;">@context.Email</p>
					</div>
				</TemplateColumn>

				<TemplateColumn Title="Event" Class="px-3 py-2 text-muted">
					<div class="text-muted text-truncate" style="max-width: 180px;">
						@context.UserEvent?.Name
					</div>
				</TemplateColumn>

				<TemplateColumn Title="Ticket Type" Class="px-3 py-2 text-muted">
					@context.TicketType?.Name
				</TemplateColumn>

				<TemplateColumn Title="Status" Class="px-3 py-2 text-muted">
					@context.RegisterStatus?.Name
				</TemplateColumn>

				<PropertyColumn Property="@(e => e.RegisterDate)" Format="MMM dd, yyyy" Title="Registered" Class="text-muted" />

				<TemplateColumn Title="Actions">
				</TemplateColumn>
			</QuickGrid>
		</div>

		<div class="mt-3 d-flex justify-content-between align-items-center">
			<div class="text-muted" style="font-size: 0.9rem;">
				<h6>
					Showing @(pagination.TotalItemCount > 0 ? (pagination.CurrentPageIndex * pagination.ItemsPerPage) + 1 : 0)
					to @Math.Min((pagination.CurrentPageIndex + 1) * pagination.ItemsPerPage, pagination.TotalItemCount ?? 0)
					of @pagination.TotalItemCount records
				</h6>
			</div>

			<!-- The actual Bootstrap buttons -->
			@if (pagination.TotalItemCount.HasValue && pagination.TotalItemCount > 0)
			{
				<nav aria-label="Page navigation">
					<ul class="pagination pagination-md m-0">

						<!-- Previous Button -->
						<li class="page-item @(pagination.CurrentPageIndex == 0 ? "disabled" : "")">
							<button class="page-link" @onclick="() => pagination.SetCurrentPageIndexAsync(pagination.CurrentPageIndex - 1)">
								Previous
							</button>
						</li>

						<!-- Page Numbers -->
						@{
							// Calculate the start and end page to display
							int maxVisiblePages = 5;
							int startPage = Math.Max(0, pagination.CurrentPageIndex - (maxVisiblePages / 2));
							int endPage = Math.Min(pagination.LastPageIndex ?? 0, startPage + maxVisiblePages - 1);

							// Adjust start page if we are near the end
							startPage = Math.Max(0, endPage - maxVisiblePages + 1);
						}

						@for (int i = startPage; i <= endPage; i++)
						{
							var pageIndex = i; // Local variable needed for Blazor loop binding
						   					<li class="page-item @(pagination.CurrentPageIndex == pageIndex ? "active" : "")">
						   						<button class="page-link" @onclick="() => pagination.SetCurrentPageIndexAsync(pageIndex)">
						   							@(pageIndex + 1)
						   						</button>
						   					</li>
						}

						<!-- Next Button -->
						<li class="page-item @(pagination.CurrentPageIndex == pagination.LastPageIndex ? "disabled" : "")">
							<button class="page-link" @onclick="() => pagination.SetCurrentPageIndexAsync(pagination.CurrentPageIndex + 1)">
								Next
							</button>
						</li>

					</ul>
				</nav>
			}
		</div>
	</div>
</div>



@code {
	private List<Registered> registeredUser = new();
	private List<UserEvent> userEvents = new();
	private List<Registered> filteredUser = new();
	private List<RegisterStatus> regStatus = new();
	private Guid eventId;
	private int? regStatusId;

	private PaginationState pagination = new PaginationState { ItemsPerPage = 15};

	private int registerCount;

	private string? searchUser = string.Empty;

	protected override async Task OnInitializedAsync()
	{
		pagination.TotalItemCountChanged += OnTotalItemCountChanged;
		await LoadRegistered();
	}

	private void OnTotalItemCountChanged(object? sender, int? newCount)
	{
		InvokeAsync(StateHasChanged);
	}

	public void Dispose()
	{
		if (pagination != null)
		{
			pagination.TotalItemCountChanged -= OnTotalItemCountChanged;
		}
	}

	private async Task LoadRegistered()
	{
		using var Db = await DbFactory.CreateDbContextAsync();
		registeredUser = await Db.Registered
			.AsNoTracking()
			.AsSplitQuery()
			.Include(e => e.UserEvent)
			.Include(e => e.TicketType)
			.Include(e => e.RegisterStatus)
			// .Where(e => e.UserEvent!.Status == EventStatusEnum.Published)
			.ToListAsync();

		userEvents = await Db.UserEvents.ToListAsync();
		regStatus = await Db.RegisterStatus.ToListAsync();

		registerCount = registeredUser.Count();
		filteredUser = registeredUser;
	}

	private void FilterList(ChangeEventArgs e)
	{
		searchUser = e.Value?.ToString() ?? "";
		FilterByEvent();

		if (string.IsNullOrWhiteSpace(searchUser))
		{
			FilterByEvent();
			return;
		}
	}

	private void FilterByEvent()
	{
		if (eventId == Guid.Empty && regStatusId == null)
		{
			filteredUser = registeredUser.Where(e => e.FullName.Contains(searchUser ?? "", StringComparison.OrdinalIgnoreCase)).ToList();
			return;
		}
		else if (eventId == Guid.Empty)
		{
			filteredUser = registeredUser.Where(e => e.FullName.Contains(searchUser ?? "", StringComparison.OrdinalIgnoreCase) && e.StatusId == regStatusId).ToList();
			return;
		}
		else if (regStatusId == null)
		{
			filteredUser = registeredUser.Where(e => e.FullName.Contains(searchUser ?? "", StringComparison.OrdinalIgnoreCase) && e.EventId == eventId).ToList();
			return;
		}
		else
		{
			filteredUser = registeredUser.Where(e => e.FullName.Contains(searchUser ?? "", StringComparison.OrdinalIgnoreCase) && e.EventId == eventId && e.StatusId == regStatusId).ToList();	
		}
		registerCount = filteredUser.Count;
	}

}
