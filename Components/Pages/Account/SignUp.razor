@page "/Account/Register"
@layout Layout.EmptyLayout

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using EMSWebApp.Models
@inject UserManager<AppUser> UserManager
@inject NavigationManager NavigationManager

<div class="d-flex justify-content-center align-content-center align-items-center h-100">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h3 class="card-title text-center mb-4">Create an Account</h3>

                @if (Errors.Any())
                {
                    <div class="alert alert-danger">
                        @foreach (var error in Errors)
                        {
                            <p class="mb-0">@error</p>
                        }
                    </div>
                }

                <EditForm Model="Input" FormName="RegisterForm" OnValidSubmit="RegisterUser">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <InputText @bind-Value="Input.FullName" class="form-control" placeholder="John Doe" />
                        <ValidationMessage For="() => Input.FullName" class="alert alert-danger text-danger py-2 mt-1 " />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email Address</label>
                        <InputText @bind-Value="Input.Email" class="form-control" placeholder="name@example.com" />
                        <ValidationMessage For="() => Input.Email" class="alert alert-danger text-danger py-2 mt-1 " />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <InputText @bind-Value="Input.Password" type="password" class="form-control" placeholder="Minimum 8 characters" />
                        <ValidationMessage For="() => Input.Password" class="alert alert-danger text-danger py-2 mt-1 " />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Confirm Password</label>
                        <InputText @bind-Value="Input.ConfirmPassword" type="password" class="form-control" placeholder="Repeat password" />
                        <ValidationMessage For="() => Input.ConfirmPassword" class="alert alert-danger text-danger py-2 mt-1 " />
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success">Register</button>
                    </div>
                </EditForm>

                <div class="mt-3 text-center">
                    <p class="mb-0 text-muted">Already have an account? <a href="/Account/Login">Sign In</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private RegisterInput Input { get; set; } = new();

    private List<string> Errors { get; set; } = new();

    private async Task RegisterUser()
    {
        Errors.Clear();

        // 1. Map the inputs to your AppUser object structure
        var user = new AppUser
        {
            UserName = Input.Email,
            Email = Input.Email,
            FullName = Input.FullName,
            CreatedAt = DateTime.UtcNow
        };

        // 2. Pass the user object and the plaintext password.
        // UserManager automatically checks complexity rules, hashes it, and saves it.
        var result = await UserManager.CreateAsync(user, Input.Password);

        if (result.Succeeded)
        {
            var roleResult = await UserManager.AddToRoleAsync(user, "User");

            if (!roleResult.Succeeded)
            {
                // Collect any role assignment errors if they happen
                foreach (var error in roleResult.Errors)
                {
                    Errors.Add($"Account created, but role assignment failed: {error.Description}");
                }
                return;
            }

            // Redirect smoothly to the login page so they can log in
            NavigationManager.NavigateTo("/Account/Login");
        }
        else
        {
            // Collect any errors (e.g., password missing symbols, email already taken)
            foreach (var error in result.Errors)
            {
                // Intercept the default "Username is already taken" code rule
                if (error.Code == "DuplicateUserName")
                {
                    Errors.Add($"Email '{Input.Email}' is already used.");
                }
                else
                {
                    Errors.Add(error.Description);
                }
            }
        }
    }

    public class RegisterInput
    {
        [Required(ErrorMessage = "Full Name is required.")]
        [StringLength(100, ErrorMessage = "Name is too long.")]
        public string FullName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email address is required.")]
        [EmailAddress(ErrorMessage = "Invalid email address format.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        [MinLength(8, ErrorMessage = "Password must be at least 8 characters long.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your password.")]
        [Compare("Password", ErrorMessage = "The passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}