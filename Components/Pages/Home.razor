			@* card for analytics (will show charts | will be implemented) *@
			<div class="card rounded-4 w-100 bg-white">
				<div class="card-body">
					<h5 class="card-title fw-bold">Analytics</h5>
					<p class="card-text text-muted">to be implemented</p>
				</div>
			</div>
		</div>

		<div class="d-flex gap-3 w-100">
			<div class="card rounded-4 w-100">
				<div class="card-body">
					<h5>Popular Events</h5>
				</div>
			</div>

			<div class="card rounded-4 w-100">
				<div class="card-body">
					<div class="d-flex align-items-center justify-content-between">
						<h5>Upcoming Event</h5>

						<div>
							@* pagination button will be placed here *@
							<button class="btn btn-link" disabled="@(currentIndex == 0 || upcomingEventCount == 0)" @onclick="PrevEvent">
								<i class="bi bi-chevron-left"></i>
							</button>

							<button class="btn btn-link" disabled="@(currentIndex >= upcomingEventCount - 1 || upcomingEventCount == 0)" @onclick="NextEvent">
								<i class="bi bi-chevron-right"></i>
							</button>
						</div>
					</div>
					 
					<div class="row g-3" @onclick='() => NavManager.NavigateTo($"/events/{currentEvent!.Id}")' style="cursor: pointer;" >
						@* event banner container *@
						<div class="col-12 col-md-5">
							<div class="ratio ratio-1x1 overflow-hidden rounded-3">
								@if (!string.IsNullOrEmpty(currentEvent?.StorageUrl))
								{
									<img src="@currentEvent.StorageUrl" class="w-100 h-100 object-fit-cover" alt="@currentEvent.Name" />
								}
								else
								{
									<div class="d-flex align-items-center justify-content-center bg-light text-muted w-100 h-100">
										<span>No Image</span>
									</div>
								}
							</div>
						</div>

						@* container for the event details *@
						<div class="col-12 col-md-7 d-flex flex-column">
							<h4 class="fw-bold mb-3 text-dark">@currentEvent?.Name</h4>

							@* event date *@
							<div class="d-flex align-items-center gap-2 mb-2 text-muted" style="font-size: 0.9rem;">
								<i class="bi bi-calendar-event text-primary"></i>
								<span>@currentEvent?.StartDate?.ToString("MMMM dd, yyyy")</span>
							</div>

							@* event time *@
							<div class="d-flex align-items-center gap-2 mb-2 text-muted" style="font-size: 0.9rem;">
								<i class="bi bi-clock text-primary"></i>
								<span>
									@currentEvent?.StartDate?.ToString("h:mm tt") - @currentEvent?.EndDate?.ToString("h:mm tt")
								</span>
							</div>

							@* event venue *@
							<div class="d-flex align-items-center gap-2 mb-3 text-muted" style="font-size: 0.9rem;">
								<i class="bi bi-geo-alt text-primary"></i>
								<span>@(currentEvent?.Venue?.Name ?? "Online Event")</span>
							</div>

							@* event details *@
							<p class="text-secondary small mb-0 lh-sm text-truncate-3">
								@currentEvent?.Description
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@code {
	private int ticketsSold;
	private int upcomingEventCount;
	private int totalRevenue;
	private int currentIndex = 0;

	private CultureInfo phCulture = CultureInfo.GetCultureInfo("en-PH");
	private UserEvent? currentEvent;

	protected override async Task OnInitializedAsync()
	{
		await LoadTotalCount();
		await LoadCurrentEvent();
	}

	private async Task LoadTotalCount()
	{
		upcomingEventCount = await Db.UserEvents.Where(e => e.StartDate >= DateTime.UtcNow && e.Status == EventStatusEnum.Published).CountAsync();
		ticketsSold = await Db.Registered.CountAsync();
		totalRevenue = (int)await Db.Registered.Where(r => r.TicketType != null).SumAsync(r => r.TicketType!.Price);
	}

	private async Task LoadCurrentEvent()
	{
		if (upcomingEventCount == 0) return;

		currentEvent = await Db.UserEvents
			.Include(e => e.AppUser)
			.Include(e => e.Venue)
			.Where(e => e.StartDate >= DateTime.UtcNow && e.Status == EventStatusEnum.Published)
			.OrderBy(e => e.StartDate)
			.Skip(currentIndex)
			.Take(1)
			.FirstOrDefaultAsync();
	}

	private async Task NextEvent()
	{
		if( currentIndex < upcomingEventCount - 1)
		{
			currentIndex++;
			await LoadCurrentEvent();
		}
	}

	private async Task PrevEvent()
	{
		if(currentIndex > 0)
		{
			currentIndex--;
			await LoadCurrentEvent();
		}
	}
}
