@page "/events/{Id:guid}/edit"
@attribute [Authorize]

@using System.IO
@using System.Security.Claims
@using EMSWebApp.Models
@using EMSWebApp.Models.ModelEnums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Hosting
@using Microsoft.EntityFrameworkCore

@inject IWebHostEnvironment Environment
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager

@inject EMSWebApp.Data.AppDbContext Db

@rendermode InteractiveServer

<div class="d-flex flex-column w-100 p-4" style="max-width: 48rem;">
	@* Header *@
	<a class="btn btn-outline-secondary border mb-3 px-3 py-1" style="width: max-content; border-radius: 8px;" href="/events/@Id">Back</a>
	<div class="mb-4">
		<h4 class="fw-bold">Edit Event</h4>
	</div>

	@* Form Body *@
	<div class="mb-5">

		@if (!string.IsNullOrEmpty(errMsg))
		{
			<div class="alert alert-danger">@errMsg</div>
		}

		<EditForm Model="EventModel" OnValidSubmit="HandleSubmit">
			<DataAnnotationsValidator />

			@* Banner upload *@
			<div class="card p-4 mb-3">
				<h6 class="mb-3 fw-bold">Banner Image</h6>

				@* Click to upload banner container *@
				<label class="d-flex flex-column justify-content-center align-items-center rounded-3 @(!string.IsNullOrEmpty(previewUrl) ? "d-none" : "")" style="height: 8rem; border:2px dashed #7F7F7F; cursor:pointer">
					<span class="text-secondary">Click to upload banner</span>
					<InputFile OnChange="HandleFileSelected" class="d-none" accept="image/*" />
				</label>

				@if (!string.IsNullOrEmpty(previewUrl))
				{
					@* If banner is uploaded show the image *@
					<div class="d-flex justify-content-end" style="height: 10rem; width: 100%;">
						<img src="@previewUrl" class="h-100 w-100" style="border-radius: .5rem; object-fit: cover;" alt="Alternate Text" />
						<button type="button" class="position-absolute btn-close m-2 bg-white border" @onclick="ClearSelectedFile" aria-label="Close"></button>
					</div>
				}
			</div>

			@* Container for event details *@
			<div class="card p-4 gap-3 mb-3">
				<h6 class="fw-bold">Event Details</h6>

				@* Event title *@
				<div class="">
					<label class="form-label">Title *</label>
					<InputText class="form-control" @bind-Value="EventModel!.Name" placeholder="Event title" />
					<ValidationMessage For="@(() => EventModel.Name)" />
				</div>

				@* Event Description *@
				<div class="">
					<label class="form-label">Description</label>
					<InputTextArea class="form-control" @bind-Value="EventModel.Description" placeholder="Describe the event" rows="3" />
					<ValidationMessage For="@(() => EventModel.Description)" />
				</div>

				@* Event Category and capacity *@
				@* - the event capacity must default to venue capacity if no value inputted *@
				<div class="row row-cols-1 row-cols-md-2 g-3">
					<div class="col">
						<label class="form-label">Category</label>
						<InputText class="form-control" @bind-Value="EventModel.Category" placeholder="e.g. Conference, Brainstorming" />
						<ValidationMessage For="@(() => EventModel.Category)" />
					</div>

					<div class="col">
						<label class="form-label">Capacity</label>
						<InputNumber class="form-control" @bind-Value="EventModel.Capacity" placeholder="Leave blank for default venue capacity" />
						<ValidationMessage For="@(() => EventModel.Capacity)" />
					</div>
				</div>

				@* Event type container*@
				<div class="row row-cols-1 row-cols-md-2 g-3">
					<div class="col">
						<label class="form-label">Event Type</label>
						<select class="form-select" @bind="EventModel.EventType">
							@foreach (var t in Enum.GetValues<EventTypeEnum>())
							{
								<option value="@t">@t.ToString()</option>
							}
						</select>
						<ValidationMessage For="@(() => EventModel.EventType)" />
					</div>

					<div class="col">
						<label class="form-label">Event Status</label>
						<select class="form-select" @bind="EventModel.Status">
							@foreach (var item in Enum.GetValues<EventStatusEnum>())
							{
								<option value="@item">@item.ToString()</option>
							}
						</select>
						<ValidationMessage For="@(() => EventModel.Status)" />
					</div>
				</div>
			</div>

			<div class="card p-4 gap-3 mb-3">
				<h6 class="fw-bold">Date, Time & Location</h6>

				<div class="row row-cols-1 row-cols-md-2 g-3">
					<div class="col">
						<label class="form-label">Start Date & Time *</label>
						<InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-value="EventModel.StartDate" />
						<ValidationMessage For="@(() => EventModel.StartDate)" />
					</div>

					<div class="col">
						<label class="form-label">End Date & Time *</label>
						<InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="EventModel.EndDate" />
						<ValidationMessage For="@(() => EventModel.EndDate)" />
					</div>
				</div>

				<div>
					<label class="form-label">Venue *</label>
					<InputSelect class="form-select" @bind-Value="EventModel.VenueId">
						@foreach (var ven in venues)
						{
							<option value="@ven.Id">@ven.Name</option>
						}
					</InputSelect>
					<ValidationMessage For="@(() => EventModel.VenueId)" />
				</div>
			</div>

			<div class="card p-4 gap-3 mb-3">
				<h6 class="fw-bold">Registration Date & Time</h6>

				<div class="row row-cols-1 row-cols-md-2 g-3">
					<div class="col">
						<label class="form-label">Registration Start</label>
						<InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="EventModel.RegistrationStart" />
					</div>

					<div class="col">
						<label class="form-label">Registration Deadline</label>
						<InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="EventModel.RegistrationDeadline" />
					</div>
				</div>
			</div>

			<div class="d-flex flex-row justify-content-between gap-2">
				<a class="btn btn-outline-secondary" href="/events/@Id">Cancel</a>
				<div>
					<button type="submit" class="btn btn-primary">Save Changes</button>
				</div>
			</div>
		</EditForm>
	</div>
</div>

@code {
	[Parameter]
	public Guid Id { get; set; }
	private UserEvent? EventModel { get; set; } = new UserEvent();

	private string errMsg = string.Empty;
	private IBrowserFile? selectedFile;
	private string? previewUrl;
	private string? oldStorageUrl;

	private List<Venue> venues = new();

	protected override async Task OnInitializedAsync()
	{
		venues = await Db.Venues.OrderBy(e => e.Id).Where(e => e.Status == VenueStatusEnum.Available).ToListAsync();
	}

	protected override async Task OnParametersSetAsync()
	{
		EventModel = await Db.UserEvents.FirstOrDefaultAsync(e => e.Id == Id);

		if (EventModel == null)
		{
			NavManager.NavigateTo("/events");
		}
		else
		{
			previewUrl = EventModel.StorageUrl;
			oldStorageUrl = EventModel.StorageUrl;
		}
	}

	private void ClearSelectedFile()
	{
		selectedFile = null;
		previewUrl = string.Empty;

		if (EventModel != null)
		{
			EventModel.StorageUrl = string.Empty;
			EventModel.FileName = string.Empty;
		}
	}

	private async Task HandleSubmit(EditContext args)
	{
		if (selectedFile != null)
		{
			try
			{
				var uploadsFolder = Path.Combine(Environment.WebRootPath, "uploads");
				if (!Directory.Exists(uploadsFolder))
				{
					Directory.CreateDirectory(uploadsFolder);
				}

				var fileExtension = Path.GetExtension(selectedFile.Name);
				var uniqueFileName = $"{Guid.NewGuid()}{fileExtension}";
				var secureSavePath = Path.Combine(uploadsFolder, uniqueFileName);

				long maxFileSize = 1024 * 2024 * 5;
				using var fileStream = selectedFile.OpenReadStream(maxFileSize);
				using var diskStream = new FileStream(secureSavePath, FileMode.Create);
				await fileStream.CopyToAsync(diskStream);

				EventModel!.FileName = selectedFile.Name;
				EventModel.StorageUrl = $"/uploads/{uniqueFileName}";
			}
			catch (Exception ex)
			{
				errMsg = $"1{ex.Message}";
				return;
			}
		}

		if (EventModel!.StorageUrl != oldStorageUrl && !string.IsNullOrEmpty(oldStorageUrl))
		{
			try
			{
				// Convert relative url ("/uploads/abc.jpg") to absolute system path ("C:\...\wwwroot\uploads\abc.jpg")
				var relativePath = oldStorageUrl.TrimStart('/');
				var fullOldPath = Path.Combine(Environment.WebRootPath, relativePath);

				if (File.Exists(fullOldPath))
				{
					File.Delete(fullOldPath);
				}
			}
			catch (Exception ex)
			{
				// Log or handle deletion failure if file is locked
				errMsg = $"Failed to delete old file: {ex.Message}";
			}
		}

		var localStart = DateTime.SpecifyKind(EventModel.StartDate, DateTimeKind.Local);
		EventModel.StartDate = localStart.ToUniversalTime();

		var localEnd = DateTime.SpecifyKind(EventModel.EndDate, DateTimeKind.Local);
		EventModel.EndDate = localEnd.ToUniversalTime();

		if (EventModel.RegistrationStart.HasValue)
		{
			var localRegistrationStart = DateTime.SpecifyKind(EventModel.RegistrationStart.Value, DateTimeKind.Local);
			EventModel.RegistrationStart = localRegistrationStart.ToUniversalTime();
		}

		if (EventModel.RegistrationDeadline.HasValue)
		{
			var localRegistrationEnd = DateTime.SpecifyKind(EventModel.RegistrationDeadline.Value, DateTimeKind.Local);
			EventModel.RegistrationDeadline = localRegistrationEnd.ToUniversalTime();
		}

		if(EventModel.StartDate > DateTime.UtcNow)
		{
			EventModel.Status = EventStatusEnum.Published;
		}

		try
		{
			Db.UserEvents.Update(EventModel!);
			await Db.SaveChangesAsync();

			NavManager.NavigateTo($"/events/{Id}");
		}
		catch (Exception ex)
		{
			errMsg = ex.Message;
		}
	}

	private async Task HandleFileSelected(InputFileChangeEventArgs e)
	{
		selectedFile = e.File;

		if (selectedFile != null)
		{
			try
			{
				long maxFileSize = 1024 * 1024 * 5;

				using var stream = selectedFile.OpenReadStream(maxFileSize);
				using var memoryStream = new MemoryStream();
				await stream.CopyToAsync(memoryStream);

				var base64 = Convert.ToBase64String(memoryStream.ToArray());
				previewUrl = $"data:{selectedFile.ContentType};base64,{base64}";
			}
			catch (Exception ex)
			{
				errMsg = $"Preview generation failed: {ex.Message}";
			}
		}
	}
}
