		IsImageBroken = true;
	}

	private async void HandleRegistrationNotification(Guid updatedEventId)
	{
		if (updatedEventId == Id)
		{
			await InvokeAsync(async () =>
			{
				await RefreshAllData();
				StateHasChanged();
			});
		}
	}

	private void SetTab(string tabName)
	{
		ActiveTab = tabName;
	}

	private void showAddTicket()
	{
		isEditMode = false;
		isAddTicket = true;
		isFreeTicket = true;
		TicketModel = new TicketType
		{
			EventId = Id,
			Availability = AvailabilityTypeEnum.Active,
			IsFree = true,
			Quantity = ticketLeft > 0 ? ticketLeft : SelectedEvent?.Capacity
		};
	}

	private void closeAddTicket()
	{
		isAddTicket = false;
		QuantityErr = null;
		ticketErr = null;
		TicketModel = new TicketType();
	}

	private void EditTicket(TicketType t)
	{
		isEditMode = true;
		TicketModel = new TicketType
		{
			Id = t.Id,
			Name = t.Name,
			Description = t.Description,
			Price = t.Price,
			Quantity = t.Quantity,
			EventId = t.EventId,
			IsFree = t.IsFree,
			Availability = t.Availability
		};

		isFreeTicket = t.IsFree;
		isAddTicket = true;
		ticketUsed = t.Registrations?.Count ?? 0;
	}

	private async Task HandleTicketSubmit()
	{
		QuantityErr = null;
		ticketErr = null;

		if (TicketModel.Quantity.HasValue && TicketModel.Quantity < ticketUsed)
		{
			QuantityErr = $"Ticket quantity cannot be lower than the {ticketUsed} tickets already issued.";
			return;
		}

		if (TicketModel.Quantity.HasValue && TicketModel.Quantity > ticketLeft)
		{
			QuantityErr = $"Ticket quantity cannot be exceen than the {ticketLeft} tickets left.";
			return;
		}

		TicketModel.IsFree = isFreeTicket;
		if (isFreeTicket)
		{
			TicketModel.Price = 0;
		}

		try
		{
			await using var db = await DbFactory.CreateDbContextAsync();

			if (isEditMode)
			{
				db.TicketType.Update(TicketModel);
			}
			else
			{
				TicketModel.EventId = Id;
				db.TicketType.Add(TicketModel);
			}

			await db.SaveChangesAsync();
			closeAddTicket();

			await RefreshAllData();
		}
		catch (Exception ex)
		{
			ticketErr = ex.Message;
		}
	}

	private async Task deleteTicket(TicketType t)
	{
		bool confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this ticket?");
		if (!confirmed) return;

		try
		{
			await using var Db = await DbFactory.CreateDbContextAsync();
			var ticketToDelete = await Db.TicketType.FirstOrDefaultAsync(e => e.Id == t.Id);

			if (ticketToDelete != null)
			{
				Db.TicketType.Remove(ticketToDelete);
				await Db.SaveChangesAsync();
				await RefreshAllData();
			}
		}
		catch (DbUpdateException)
		{
			ticketErr = "Ticket cannot be deleted because it is already assigned to registered attendees.";
		}
		catch (Exception ex)
		{
			ticketErr = ex.Message;
		}
	}

	private async Task UpdateAttendeeStatus(Registered registration,string? newStatusRawId)
	{
		if (!int.TryParse(newStatusRawId, out int newStatusId)) return;

		try
		{
			await using var Db = await DbFactory.CreateDbContextAsync();

			var dbRecord = await Db.Registered.FindAsync(registration.Id);
			if (dbRecord != null)
			{
				dbRecord.StatusId = newStatusId;
				dbRecord.CheckInDate = null;
				await Db.SaveChangesAsync();
				await RefreshAllData();
			}
		}
		catch (Exception ex)
		{
			errMsg = $"Failed to update attendee status: {ex.Message}";
		}
	}

	private async Task DeleteEvent(Guid eventId)
	{
		bool confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this Event? ");
		if (!confirmed) return;

		await using var Db = await DbFactory.CreateDbContextAsync();
		try
		{
			var EventToDelete = await Db.UserEvents.FindAsync(eventId);

			if (EventToDelete == null) return;

			if (!string.IsNullOrEmpty(EventToDelete.StorageUrl))
			{
				try
				{
					var cleanPath = EventToDelete.StorageUrl.TrimStart('/');
					var fullFilePath = Path.Combine(Environment.WebRootPath, cleanPath);
					if (File.Exists(fullFilePath))
					{
						File.Delete(fullFilePath);
					}

					Db.UserEvents.Remove(EventToDelete);
					await Db.SaveChangesAsync();
					NavManager.NavigateTo("/events", forceLoad: true);
				}
				catch (Exception ex)
				{
					errMsg = ex.Message;
				}
			}

		}
		catch (Exception ex)
		{
			errMsg = ex.Message;
		}
	}

	private async Task MarkComplete()
	{
		using var Db = await DbFactory.CreateDbContextAsync();
		try
		{
			var eventupdate = await Db.UserEvents.FindAsync(Id);

			if (eventupdate != null)
			{
				eventupdate.Status = EventStatusEnum.Completed;
				await Db.SaveChangesAsync();
				SelectedEvent!.Status = EventStatusEnum.Completed;
			}
		}
		catch (Exception ex)
		{
			errMsg = ex.Message;
		}
	}

	private async Task RandomPerson()
	{
		await using var db = await DbFactory.CreateDbContextAsync();

		var attendees = await db.Registered
			.AsNoTracking()
			.Where(x => x.EventId == Id)
			.ToListAsync();

		if (!attendees.Any()) return;

		var shuffled = attendees.ToArray();
		Random.Shared.Shuffle(shuffled);

		Group1.Clear();
		Group2.Clear();
		Group3.Clear();
		Group4.Clear();

		int totalNeeded = memberNum * 4;
		int countToTake = Math.Min(totalNeeded, shuffled.Length);

		for (int i = 0; i < countToTake; i++)
		{
			switch (i % 4)
			{
				case 0: Group1.Add(shuffled[i]); break;
				case 1: Group2.Add(shuffled[i]); break;
				case 2: Group3.Add(shuffled[i]); break;
				case 3: Group4.Add(shuffled[i]); break;
			}
		}
	}

