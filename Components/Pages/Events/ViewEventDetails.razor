@page "/events/{Id:guid}"
@attribute [Authorize]

@using Microsoft.EntityFrameworkCore
@using EMSWebApp.Models.ModelEnums
@using EMSWebApp.Models
@using EMSWebApp.Data
@using EMSWebApp.Services
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authorization

@inject EventNotificationService NotificationService
@inject NavigationManager NavManager
@inject IWebHostEnvironment Environment
@inject IJSRuntime JS
@inject IDbContextFactory<AppDbContext> DbFactory

@implements IDisposable

@rendermode InteractiveServer

<PageTitle>EMS | @SelectedEvent?.Name</PageTitle>

@if (SelectedEvent == null)
{
	<div class="p-4 text-center">
		<div class="spinner-border text-primary" role="status"></div>
		<p class="mt-2 text-muted">Loading event details...</p>
	</div>
}
else
{
	<div class="d-flex flex-column w-100 p-3 mt-2" style="max-width: 64rem;">
		<a class="btn btn-outline-secondary border mb-3 px-3 py-1" style="width: max-content; border-radius: 8px;" href="/events">Back</a>

		@if (!string.IsNullOrEmpty(errMsg))
		{
			<div class="alert alert-danger d-flex justify-content-between">
				<p>@errMsg</p>
				<button class="btn btn-close" @onclick="() => errMsg = null"></button>
			</div>
		}

		<div class="overflow-hidden w-100" style="height: 13rem; margin-bottom: 1.5rem; border-radius: .75rem;">
			@if (IsImageBroken || string.IsNullOrEmpty(SelectedEvent.StorageUrl))
			{
				<div class="d-flex justify-content-center align-items-center w-100" style="height: 10rem; background: #5296FA; border-radius: .75rem;">
					<svg width="56" height="57" viewBox="0 0 26 27" fill="none" xmlns="http://www.w3.org/2000/svg">
						<rect x="1" y="2.77777" width="24" height="23" rx="3" stroke="black" stroke-opacity="0.67" stroke-width="2" stroke-miterlimit="1.52425" />
						<line x1="2" y1="8.88889" x2="24" y2="8.88889" stroke="black" stroke-opacity="0.67" stroke-width="2" stroke-linecap="round" />
						<line x1="7" y1="1.11111" x2="7" y2="4.44445" stroke="black" stroke-opacity="0.67" stroke-width="2" stroke-linecap="round" />
						<path d="M19 1V4.55556" stroke="black" stroke-opacity="0.67" stroke-width="2" stroke-linecap="round" />
					</svg>
				</div>
			}
			else
			{
				<img src="@SelectedEvent.StorageUrl" @onerror="Handle404Error" class="h-100 w-100" alt="Alternate Text" style="object-fit: cover;" />
			}
		</div>

		<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
			@* Event Status *@
			<div class="d-flex flex-column flex-grow-1">
				<div class="d-flex flex-column flex-grow-1">
					<div class="d-flex flex-row gap-2 mb-1">
						<span class="badge rounded-pill @(SelectedEvent.Status == EventStatusEnum.Published ? "bg-success" : "bg-secondary")">@SelectedEvent.Status</span>
						<span class="badge rounded-pill bg-secondary">@SelectedEvent.EventType</span>
					</div>
					<h1 class="fw-bold mb-1">@SelectedEvent.Name</h1>
					<h6 class="text-muted">By @(SelectedEvent.AppUser?.FullName ?? "Unknown Host")</h6>
				</div>
			</div>

			@* Button FABs *@
			<div class="d-flex flex-wrap gap-2">
				<a class="btn btn-outline-secondary rounded-3" href="/events/@Id/preview" target="_blank">Preview</a>
				<button type="button" class="btn btn-primary rounded-3" @onclick="MarkComplete">Mark Complete</button>
				<a class="btn btn-outline-secondary rounded-3" href="/events/@Id/edit">Edit</a>
				<button type="button" class="btn btn-outline-danger rounded-3" @onclick="() => DeleteEvent(SelectedEvent.Id)">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path d="M7 21C6.45 21 5.97917 20.8042 5.5875 20.4125C5.19583 20.0208 5 19.55 5 19V6H4V4H9V3H15V4H20V6H19V19C19 19.55 18.8042 20.0208 18.4125 20.4125C18.0208 20.8042 17.55 21 17 21H7ZM17 6H7V19H17V6ZM9 17H11V8H9V17ZM13 17H15V8H13V17Z" fill="currentColor" />
					</svg>
				</button>
			</div>
		</div>

		<div class="d-flex flex-wrap gap-3 mb-3">
			<div class="card p-3 flex-grow-1 shadow-sm" style="border-radius: .75rem; min-width: 240px;">
				<h6 class="text-muted small fw-semibold">Registration Window</h6>
				<p class="mb-1">@(SelectedEvent.RegistrationStart?.ToLocalTime().ToString("ddd, MMM dd • h:mm tt") ?? "N/A")</p>
				<hr class="my-2" />
				<h6 class="text-muted small fw-semibold">Registration Deadline</h6>
				<p class="mb-0">@(SelectedEvent.RegistrationDeadline?.ToLocalTime().ToString("ddd, MMM dd • h:mm tt") ?? "N/A")</p>
			</div>

			<div class="card p-3 flex-grow-1 shadow-sm" style="border-radius: .75rem; min-width: 240px;">
				<h6 class="text-muted small fw-semibold">Event Start</h6>
				<p class="mb-1">@(SelectedEvent.StartDate?.ToLocalTime().ToString("ddd, MMM dd • h:mm tt") ?? "N/A")</p>
				<hr class="my-2" />
				<h6 class="text-muted small fw-semibold">Event End</h6>
				<p class="mb-0">@(SelectedEvent.EndDate?.ToLocalTime().ToString("ddd, MMM dd • h:mm tt") ?? "N/A")</p>
			</div>

			<div class="card p-3 flex-grow-1 shadow-sm justify-content-center" style="border-radius: .75rem; min-width: 240px;">
				<h6 class="text-muted small fw-semibold">Event Duration</h6>
				<p class="mb-1">@(eventDurationDays == 0 ? $"{eventDurationHours}-Hour event" : $"{eventDurationDays}-Day event")</p>
				<hr class="my-2" />
				<h6 class="text-muted small fw-semibold">Location</h6>
				<p class="mb-0">@(SelectedEvent.Venue != null ? $"{SelectedEvent.Venue.Name}, {SelectedEvent.Venue.Address}" : "Online / TBA")</p>
			</div>
		</div>

		<div class="d-flex flex-row gap-3 mb-4">
			<div class="card d-flex flex-column justify-content-center align-items-center flex-grow-1 p-3 shadow-sm rounded-4">
				<strong class="fs-4">@SelectedEvent.Capacity</strong>
				<span class="text-muted small">Capacity</span>
			</div>
			<div class="card d-flex flex-column justify-content-center align-items-center flex-grow-1 p-3 shadow-sm rounded-4">
				<strong class="fs-4">@RegisterCount</strong>
				<span class="text-muted small">Registered</span>
			</div>
			<div class="card d-flex flex-column justify-content-center align-items-center flex-grow-1 p-3 shadow-sm rounded-4">
				<strong class="fs-4">@checkedInCount</strong>
				<span class="text-muted small">Checked-in</span>
			</div>
		</div>

		<div class="d-flex flex-row border-bottom gap-2 mb-4 align-items-center" style="border-color: #e5e7eb !important;">
			<button type="button"
					class="tab-btn @(ActiveTab == "Overview" ? "tab-active" : "text-muted")"
					@onclick='() => SetTab("Overview")'>
				Overview
			</button>
			<button type="button"
					class="tab-btn @(ActiveTab == "Tickets" ? "tab-active" : "text-muted")"
					@onclick='() => SetTab("Tickets")'>
				Tickets
			</button>
			<button type="button"
					class="tab-btn @(ActiveTab == "Registrations" ? "tab-active" : "text-muted")"
					@onclick='() => SetTab("Registrations")'>
				Registrations
			</button>
			<button type="button"
					class="tab-btn @(ActiveTab == "Ramdomize" ? "tab-active" : "text-muted")"
					@onclick='() => SetTab("Ramdomize")'>
				Randomize
			</button>
		</div>

		<div>
			@switch (ActiveTab)
			{
				case "Overview":
					<div class="card p-4 shadow-sm rounded-4">
						<h6 class="fw-bold mb-2">About this event</h6>
						<p class="text-muted mb-0" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(SelectedEvent.Description) ? "No description provided." : SelectedEvent.Description)</p>
					</div>
					break;


				case "Tickets":
					<div class="d-flex flex-column gap-3">
						<div class="d-flex justify-content-between align-items-center">
							<span class="text-muted small">Remaining Allocatable Capacity: <strong>@ticketLeft</strong></span>
							<button class="btn btn-primary rounded-3 btn-sm" @onclick="showAddTicket">
								+ Add Ticket Type
							</button>
						</div>

						@if(!string.IsNullOrEmpty(ticketErr))
						{
							<div class="alert alert-danger d-flex justify-content-between align-items-center mb-0">
								<span>@ticketErr</span>
								<button type="button" class="btn-close" @onclick="() => ticketErr = null"></button>
							</div>
						}

						@if(isAddTicket)
						{
							@* Add ticket form *@
							<EditForm Model="TicketModel" OnValidSubmit="HandleTicketSubmit">
								<DataAnnotationsValidator />

								<div class="card p-4 rounded-4 shadow-sm border border-primary-subtle" style="border-radius: .75rem; border: 1px #4f46e579 solid">
									<h5 class="fw-bold mb-3">@(isEditMode ? "Edit Ticket Type" : "New Ticket Type")</h5>

									<div class="mb-3">
										<label class="form-label small fw-semibold" for="name">Ticket Name *</label>
										<InputText class="form-control" @bind-Value="TicketModel.Name" id="name" placeholder="e.g., General Admission, VIP" />
										<ValidationMessage For="@(() => TicketModel.Name)" class="text-danger small" />
									</div>

									<div class="mb-3">
										<label class="form-label small fw-semibold" for="description">Description</label>
										<InputText class="form-control" @bind-Value="TicketModel.Description" id="description" placeholder="Optional description" />
									</div>

									<div class="form-check mb-3">
										<InputCheckbox @bind-Value="isFreeTicket" class="form-check-input" id="freeCheck" />
										<label class="form-check-label" for="freeCheck">Free ticket</label>
									</div>

									@if(!isFreeTicket)
									{
										<div class="mb-3">
											<label class="form-label small fw-semibold" for="price">Price (PHP)</label>
											<InputNumber class="form-control" @bind-Value="TicketModel.Price" id="price" />
										</div>
									}

									<div class="row g-3 mb-3">
										<div class="col-md-6">
											<label class="form-label small fw-semibold" for="quantity">Quantity Limit</label>
											<InputNumber class="form-control" @bind-Value="TicketModel.Quantity" id="quantity" placeholder="@SelectedEvent.Capacity" />
											<ValidationMessage For="@(() => TicketModel.Quantity)" class="text-danger small" />
											@if (!string.IsNullOrEmpty(QuantityErr))
											{
												<span class="alert alert-danger text-danger small d-block mt-1">@QuantityErr</span>
											}
										</div>

										<div class="col-md-6">
											<label class="form-label small fw-semibold" for="availability">Status</label>
											<InputSelect class="form-select" @bind-Value="TicketModel.Availability" id="availability">
												<option value="@AvailabilityTypeEnum.Active">Active</option>
												<option value="@AvailabilityTypeEnum.Paused">Paused</option>
											</InputSelect>
										</div>
									</div>

									<div class="d-flex gap-2">
										<button class="btn btn-primary rounded-3 px-4" type="submit">Save</button>
										<button class="btn btn-outline-secondary rounded-3 px-3" type="button" @onclick="closeAddTicket">Cancel</button>
									</div>
								</div>
							</EditForm>
						}

						@if (!Tickets.Any())
						{
							<div class="card d-flex flex-column justify-content-center align-items-center" style="border-radius: .75rem; padding: 2rem;">
								<p class="text-muted">No ticket types yet.</p>

								<a class="btn-link text-decoration-none" @onclick="showAddTicket" style="cursor: pointer; color: #4f46e5;">
									+ Add ticket type
								</a>
							</div>
						}
						else
						{
							<div class="d-flex flex-column gap-2">
								@foreach(var t in Tickets)
								{
									var ticketCounted = t.Registrations?.Count ?? 0;
									var maxQuantity = t.Quantity ?? SelectedEvent?.Capacity ?? 0;

									<div class="card p-3 shadow-sm rounded-3 d-flex flex-row justify-content-between align-items-center">
										<div>
											<div class="d-flex align-items-center gap-2 mb-1">
												<h6 class="mb-0 fw-bold">@t.Name</h6>
												<span class="badge rounded-pill @(t.Availability == AvailabilityTypeEnum.Active ? "bg-success" : "bg-secondary")">@t.Availability</span>
											</div>
											<p class="text-muted small mb-1">@t.Description</p>
											<div class="d-flex gap-2 small text-muted">
												<span class="fw-semibold">@(t.IsFree ? "Free" : $"₱{t.Price:N2}")</span>
												<span>•</span>
												<span>@ticketCounted / @maxQuantity claimed</span>
											</div>
										</div>

										<div class="d-flex flex-row gap-2 align-items-center">
											<div class="edit" @onclick="() => EditTicket(t)">
												<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16">
													<path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" />
													<path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
												</svg>
											</div>

											<div class="edit" @onclick="() => deleteTicket(t)">
												<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="#dc3545" class="bi bi-trash" viewBox="0 0 16 16">
													<path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
													<path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
												</svg>
											</div>
										</div>
									</div>
								}
							</div>
						}
					</div>
					break;

				case "Registrations":
					<div class="card overflow-hidden shadow-sm rounded-4">
						<div class="card-header d-flex justify-content-between align-items-center bg-transparent p-3">
							<h6 class="mb-0 fw-bold">Registrations (@(SelectedEvent.Registrations?.Count ?? 0))</h6>
							<a class="btn btn-primary" style="border-radius: .75rem; font-size: 0.9em;" href="">Add Registrants</a>
						</div>

						@if (SelectedEvent.Registrations != null && SelectedEvent.Registrations.Any())
						{
							<div class="table-responsive">
								<QuickGrid Items="SelectedEvent.Registrations.AsQueryable()" Pagination="@pagination" Class="table table-hover align-middle m-0" style="font-size: 0.875rem;">
									<TemplateColumn Title="Attendee" Class="px-3 py-2">
										<span style="font-size: 0.875rem; font-weight: 500;">@context.FullName</span>
									</TemplateColumn>

									<PropertyColumn Property="@(c => c.Email)" Title="Email" Class="px-3 py-2 text-muted" />

									<TemplateColumn Title="Ticket" Class="px-3 py-2">
										<span>@(context.TicketType?.Name ?? "Standard")</span>
									</TemplateColumn>

									<TemplateColumn Title="Status" Class="px-3 py-2">
										<select class="form-select form-select-sm rounded-2" 
												value="@context.RegisterStatus?.Id" 
												@onchange="(e) => UpdateAttendeeStatus(context, e.Value?.ToString())">
											@foreach (var item in AllStatus)
											{
												<option value="@item.Id">@item.Name</option>
											}
										</select>
									</TemplateColumn>
								</QuickGrid>
							</div>

							<div class="card-footer bg-transparent border-top p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
								<div class="text-muted small">
									Showing @(pagination.TotalItemCount > 0 ? (pagination.CurrentPageIndex * pagination.ItemsPerPage) + 1 : 0)
									to @Math.Min((pagination.CurrentPageIndex + 1) * pagination.ItemsPerPage, pagination.TotalItemCount ?? 0)
									of @(pagination.TotalItemCount ?? 0) records
								</div>

								@if (pagination.TotalItemCount.HasValue && pagination.TotalItemCount > 0)
								{
									<nav aria-label="Page navigation">
										<ul class="pagination pagination-sm m-0">
											<!-- Previous Button -->
											<li class="page-item @(pagination.CurrentPageIndex == 0 ? "disabled" : "")">
												<button class="page-link" @onclick="() => pagination.SetCurrentPageIndexAsync(pagination.CurrentPageIndex - 1)">Previous</button>
											</li>

											<!-- Page Numbers -->
											@{
												int maxVisiblePages = 5;
												int startPage = Math.Max(0, pagination.CurrentPageIndex - (maxVisiblePages / 2));
												int endPage = Math.Min(pagination.LastPageIndex ?? 0, startPage + maxVisiblePages - 1);
												startPage = Math.Max(0, endPage - maxVisiblePages + 1);
											}

											@for (int i = startPage; i <= endPage; i++)
											{
												var pageIndex = i;
												<li class="page-item @(pagination.CurrentPageIndex == pageIndex ? "active" : "")">
													<button class="page-link" @onclick="() => pagination.SetCurrentPageIndexAsync(pageIndex)">@(pageIndex + 1)</button>
												</li>
											}

											<!-- Next Button -->
											<li class="page-item @(pagination.CurrentPageIndex == pagination.LastPageIndex ? "disabled" : "")">
												<button class="page-link" @onclick="() => pagination.SetCurrentPageIndexAsync(pagination.CurrentPageIndex + 1)">Next</button>
											</li>
										</ul>
									</nav>
								}
							</div>
						}
						else
						{
							<div class="card-body p-5">
								<h6 class="text-muted text-center">No registrations yet.</h6>
							</div>
						}
					</div>
					break;

				case "Ramdomize":
					<div class="card p-4 shadow-sm rounded-4">
						<div class="row g-3 align-items-center mb-4">
							<div class="col-auto">
								<label class="col-form-label fw-semibold">Members per group:</label>
							</div>
							<div class="col-auto">
								<InputNumber class="form-control rounded-3" @bind-Value="memberNum" min="1" max="100" style="width: 100px;" />
							</div>
							<div class="col-auto">
								<button class="btn btn-primary rounded-3" @onclick="RandomPerson">Randomize into 4 Groups</button>
							</div>
						</div>

						<div class="row g-3">
							<div class="col-md-3">
								<div class="card p-3 bg-light border-0 rounded-3">
									<h6 class="fw-bold mb-2">Group 1 (@Group1.Count)</h6>
									@foreach (var item in Group1)
									{
										<div class="small py-1 text-truncate border-bottom">@item.FullName</div>
									}
								</div>
							</div>
							<div class="col-md-3">
								<div class="card p-3 bg-light border-0 rounded-3">
									<h6 class="fw-bold mb-2">Group 2 (@Group2.Count)</h6>
									@foreach (var item in Group2)
									{
										<div class="small py-1 text-truncate border-bottom">@item.FullName</div>
									}
								</div>
							</div>
							<div class="col-md-3">
								<div class="card p-3 bg-light border-0 rounded-3">
									<h6 class="fw-bold mb-2">Group 3 (@Group3.Count)</h6>
									@foreach (var item in Group3)
									{
										<div class="small py-1 text-truncate border-bottom">@item.FullName</div>
									}
								</div>
							</div>
							<div class="col-md-3">
								<div class="card p-3 bg-light border-0 rounded-3">
									<h6 class="fw-bold mb-2">Group 4 (@Group4.Count)</h6>
									@foreach (var item in Group4)
									{
										<div class="small py-1 text-truncate border-bottom">@item.FullName</div>
									}
								</div>
							</div>
						</div>
					</div>
					break;
			}
		</div>
	</div>
}

@code {
	[Parameter]
	public Guid Id { get; set; }

	private bool isAddTicket = false;
	private bool IsImageBroken = false;
	private bool isFreeTicket = true;
	private bool isEditMode = false;

	private string ActiveTab { get; set; } = "Overview";
	private string? QuantityErr;
	private string? errMsg;
	private string? ticketErr;

	private int RegisterCount;
	private int checkedInCount;
	private int eventDurationDays;
	private int eventDurationHours;
	private int ticketLeft;
	private int ticketUsed = 0;
	private int memberNum = 1;

	private List<RegisterStatus> AllStatus { get; set; } = new();
	private List<TicketType> Tickets => SelectedEvent?.TicketTypes.ToList() ?? new();
	private UserEvent? SelectedEvent { get; set; }
	private PaginationState pagination = new PaginationState { ItemsPerPage = 15 };

	public List<Registered> Group1 { get; set; } = new();
	public List<Registered> Group2 { get; set; } = new();
	public List<Registered> Group3 { get; set; } = new();
	public List<Registered> Group4 { get; set; } = new();

	private TicketType TicketModel { get; set; } = new();

	protected override void OnInitialized()
	{
		NotificationService.OnRegistrationAdded += HandleRegistrationNotification;
	}

	protected override async Task OnParametersSetAsync()
	{
		await RefreshAllData();

		if (SelectedEvent == null)
		{
			NavManager.NavigateTo("/events");
		}
	}

	private async Task RefreshAllData()
	{
		await using var db = await DbFactory.CreateDbContextAsync();

		SelectedEvent = await db.UserEvents
			.AsNoTracking()
			.AsSplitQuery()
			.Include(e => e.AppUser)
			.Include(e => e.Venue)
			.Include(e => e.Registrations)
				.ThenInclude(r => r.TicketType)
			.Include(e => e.TicketTypes)
				.ThenInclude(t => t.Registrations)
			.FirstOrDefaultAsync(e => e.Id == Id);

		if (SelectedEvent != null)
		{
			var duration = (SelectedEvent.EndDate ?? DateTime.UtcNow) - (SelectedEvent.StartDate ?? DateTime.UtcNow);
			eventDurationDays = Math.Max(0, duration.Days);
			eventDurationHours = Math.Max(0, duration.Hours);

			AllStatus = await db.RegisterStatus.AsNoTracking().ToListAsync();

			// Calculate registrations and check-ins directly in SQL
			RegisterCount = await db.Registered.AsNoTracking().CountAsync(r => r.EventId == Id);
			checkedInCount = await db.Registered.AsNoTracking().CountAsync(r => r.EventId == Id && (r.CheckInDate != null || r.CheckInDate2 != null || r.StatusId == 4));

			// Compute remaining available capacity
			var allocatedTickets = await db.TicketType
				.Where(e => e.EventId == Id)
				.SumAsync(e => (int?)e.Quantity) ?? 0;

			ticketLeft = Math.Max(0, (SelectedEvent.Capacity ?? 0) - allocatedTickets);
		}
	}

