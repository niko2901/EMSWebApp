@page "/events/{Id:guid}/preview"
@layout Layout.EmptyLayout

@using Microsoft.EntityFrameworkCore
@using EMSWebApp.Models
@using EMSWebApp.Models.ModelEnums
@using EMSWebApp.Services

@inject EventNotificationService NotificationService
@inject NavigationManager NavManager
@inject TicketPdfService PdfService
@inject IJSRuntime JS
@inject IDbContextFactory<AppDbContext> DbFactory


@rendermode InteractiveServer

<div class="w-100 overflow-hidden" style="height: 20rem;">
	<img src="@SelectedEvent?.storageURL" class="h-100 w-100" style="object-fit: cover;"/>
</div>



<div class="d-flex justify-content-center" style="background: rgb(248, 250, 252);">
	<div class="d-flex flex-column gap-4" style="width: 48rem; padding: 2rem 1rem 2rem 1rem; min-height: 100%;">

		@* condition for checking if the event is still available *@
		@if (SelectedEvent?.Status != EventStatusEnum.Published)
		{
			<div class="card p-4 gap-3 @(SelectedEvent?.Status != EventStatusEnum.Published ? "d-none" : "")">
				<h3>Registration for this Event is Now Closed</h3>
				<p>
					The sign-up deadline for this event passed on <strong>@SelectedEvent?.RegistrationDeadline</strong>.<br />
					We are busy finalizing details and materials for our attendees and can no longer accept new registrations.
				</p>
			</div>
		}
		else
		{
			<div class="d-flex gap-2">
				<span class="badge rounded-pill bg-success">@SelectedEvent?.Status</span>
				<span class="badge rounded-pill bg-secondary">@SelectedEvent?.EventType</span>
			</div>

			<div>
				<h1 class="fw-bold">@SelectedEvent?.Title</h1>
				<p class="text-muted">Organized by @SelectedEvent?.OrganizerFullName</p>
			</div>

			<div class="d-flex flex-column gap-4 @(isSuccess ? "d-none" : "")">
				<div class="d-flex flex-column flex-lg-row gap-1 gap-lg-3">
					<div class="card p-3 flex-grow-1">
						<h6 class="text-muted" style="font-weight: 400;">Start</h6>
						<p style="font-weight: 400; font-size: 16px;">@(SelectedEvent?.StartDate.HasValue == true ? SelectedEvent.StartDate.Value.ToLocalTime().ToString("dddd, MMM dd \u2022 hh:mm tt") : "")</p>
					</div>

					<div class="card p-3 flex-grow-1">
						<h6 class="text-muted" style="font-weight: 400;">End</h6>
						<p style="font-weight: 400; font-size: 16px;">@(SelectedEvent?.EndDate.HasValue == true ? SelectedEvent.EndDate.Value.ToLocalTime().ToString("dddd, MMM dd \u2022 hh:mm tt") : "")</p>
					</div>

					<div class="card p-3 flex-grow-1">
						<h6 class="text-muted" style="font-weight: 400;">Location</h6>
						<p style="font-weight: 400; font-size: 16px;">@SelectedEvent?.VenueName, @SelectedEvent?.Location</p>
					</div>
				</div>

				<h6 class="fw-normal text-muted">Capacity: <strong class="text-black">@SelectedEvent?.Capacity</strong> Attendees</h6>

				@if (SelectedEvent?.Description != "")
				{
					<div class="card p-4">
						<h6 class="mb-1">About this event</h6>
						<p class="text-muted">@SelectedEvent?.Description</p>
					</div>
				}

				@if (AvailableTickets.Count != 0)
				{
					<div class="card p-4">
						<h6 class="mb-1">Tickets</h6>

						@foreach (var item in AvailableTickets)
						{
							var ticketRemaining = item.Quantity - item.RegistrationsCount;
							<div class="ticket d-flex flex-row justify-content-between border-bottom py-3 gap-2">
								<div>
									<h6>@item.Name</h6>
									<p class="text-muted" style="font-size: .8rem;">@item.Description</p>
									<p class="text-muted" style="font-size: .8rem;">@ticketRemaining remaining</p>
								</div>
								<div class="align-self-center">
									<h4>@(item.IsFree == true ? "Free" : $"₱{item.Price}")</h4>
								</div>
							</div>
						}
					</div>
				}

				<div class="card p-4 gap-4">
					<h6>Register for this event</h6>
					<EditForm Model="RegisterModel" OnValidSubmit="HandleSubmit">
						<DataAnnotationsValidator />

						<div class="alert-danger">
							@errMessage
						</div>

						<div class="d-flex flex-column gap-3">
							@if (AvailableTickets.Count != 0)
							{
								<div>
									<label class="form-label">Ticket Type</label>
									<InputSelect class="form-select" @bind-Value="RegisterModel.TicketTypeId">
										<option value="@Guid.Empty" selected>- Select Ticket Type -</option>
										@foreach (var item in AvailableTickets)
										{
											<option value="@item.Id">@item.Name</option>
										}
									</InputSelect>
									<ValidationMessage class="alert alert-danger px-2 py-1 my-1 rounded" For="@(() => RegisterModel.TicketTypeId)" />
									<div class="alert alert-danger px-2 py-1 my-1 rounded @(string.IsNullOrEmpty(selectErr) ? "d-none" : "")">@selectErr</div>
								</div>
							}

							<div>
								<label class="form-label" for="name">Full Name *</label>
								<InputText class="form-control" @bind-Value="RegisterModel.FullName" id="name" placeholder="John Dela Cruz" />
							</div>

							<div>
								<label class="form-label" for="email">Email *</label>
								<InputText type="email" class="form-control" @bind-Value="RegisterModel.Email" id="email" placeholder="email@example.com" />
							</div>

							<div>
								<label class="form-label" for="phone">Phone <span class="text-muted">(Optional)</span></label>
								<InputText class="form-control" @bind-Value="RegisterModel.Phone" id="phone" placeholder="+63 9XX XXX XXXX" maxlength="11" />
							</div>

							<button type="submit" class="btn btn-primary py-2 fw-bold" style="border-radius: .75rem;" disabled="@isSubmitting">@(isSubmitting ? "Submitting..." : "Register Now")</button>
						</div>
					</EditForm>
				</div>
			</div>

			@* show after registration to verify using email. *@
			@if (isSuccess)
			{
				<div class="card p-4 gap-3 ">
					<h3>🎉 You're registered!</h3>
					<p>
						Please download your Event Pass below. You will need to present this QR ticket at the entrance for check-in.
					</p>
					<button class="btn btn-primary" @onclick="DownloadPdfTicket" style="cursor: pointer;">Download Event Ticket</button>.
				</div>
			}
		}
	</div>
</div>

@code {
	[Parameter]
	public Guid Id { get; set; }

	public Guid RegistrationId { get; set; }
	public string RegistrationName { get; set; } = string.Empty;

	private bool isSuccess = false;
	private bool isSubmitting = false;
	private string userEmail = string.Empty;

	private string errMessage = string.Empty;
	private string selectErr = string.Empty;

	private EventDetailsDTO? SelectedEvent { get; set; }
	private List<TicketTypeDTO> AvailableTickets => SelectedEvent?.TicketTypes?
																.Where(e => e.Availability == Models.ModelEnums.AvailabilityTypeEnum.Active)
																.ToList() ?? new();

	private Registered RegisterModel { get; set; } = new Registered
	{
		FullName = string.Empty,
		Email = string.Empty,
		Phone = string.Empty,
		StatusId = 2,
		RegisterDate = DateTime.UtcNow
	};

	protected override async Task OnParametersSetAsync()
	{
		using var Db = await DbFactory.CreateDbContextAsync();

		// SelectedEvent = await Db.UserEvents
		// 	.AsNoTracking()
		// 	.AsSplitQuery()
		// 	.Include(e => e.Venue)
		// 	.Include(e => e.AppUser)
		// 	.Include(e => e.TicketTypes)
		// 		.ThenInclude(e => e.Registrations)
		// 	.FirstOrDefaultAsync(e => e.Id == Id);

		SelectedEvent = await Db.UserEvents
			.Where(e => e.Id == Id)
			.Select(e => new EventDetailsDTO
			{
				storageURL = e.StorageUrl,
				Status = e.Status,
				EventType = e.EventType,
				Title = e.Name,
				StartDate = e.StartDate,
				EndDate = e.EndDate,
				RegistrationDeadline = e.RegistrationDeadline,
				VenueName = e.Venue!.Name,
				Location = e.Venue!.Address,
				Capacity = e.Capacity,
				Description = e.Description,
				OrganizerFullName = e.AppUser!.FullName,
				TicketTypes = e.TicketTypes.Select(t => new TicketTypeDTO
				{
					Id = t.Id,
					Name = t.Name,
					Description = t.Description,
					IsFree = t.IsFree,
					Price = t.Price,
					Quantity = t.Quantity,
					Availability = t.Availability,
					RegistrationsCount = t.Registrations.Count() // Calculated cleanly in SQL database
				}).ToList()
			})
			.FirstOrDefaultAsync();


		if (SelectedEvent == null)
		{
			NavManager.NavigateTo("/events");
		}
	}

	public async Task HandleSubmit()
	{
		using var Db = await DbFactory.CreateDbContextAsync();

		isSubmitting = true;
		RegisterModel.EventId = Id;
		userEmail = RegisterModel.Email;

		if (RegisterModel.TicketTypeId == Guid.Empty)
		{
			selectErr = "Ticket Type is required.";
			isSubmitting = false;
			return;
		}

		try
		{
			Db.Registered.Add(RegisterModel);
			var res = await Db.SaveChangesAsync();

			if(res > 0)
			{
				RegistrationId = RegisterModel.Id;
				RegistrationName = RegisterModel.FullName;
				isSuccess = true;
				NotificationService.NotifyRegistrationChange(RegisterModel.EventId);
			}
			isSubmitting = false;
		}
		catch (Exception ex)
		{
			errMessage = ex.Message;
			isSubmitting = false;
		}
	}

	private async Task DownloadPdfTicket()
	{
		// 1. Generate PDF byte array in C#
		byte[] pdfBytes = PdfService.GenerateTicketPDF(RegistrationId, SelectedEvent!.Title, RegistrationName);

		// 2. Convert bytes to base64 string
		string base64Pdf = Convert.ToBase64String(pdfBytes);

		// 3. Trigger browser file save
		var fileName = $"Ticket-{RegistrationId}.pdf";
		await JS.InvokeVoidAsync("downloadByteArrayFile", base64Pdf, fileName);
	}


	// Data Transfer Object Models
	public class EventDetailsDTO
	{
		public string Title { get; set; } = string.Empty;
		public string OrganizerFullName { get; set; } = string.Empty;
		public string? storageURL { get; set; }
		public string? Description { get; set; }
		public int? Capacity { get; set; }
		public string Location { get; set; } = string.Empty;
		public string VenueName { get; set; } = string.Empty;
		public DateTime? StartDate { get; set; }
		public DateTime? EndDate { get; set; }
		public DateTime? RegistrationDeadline { get; set; }
		public EventStatusEnum Status { get; set; }
		public EventTypeEnum EventType { get; set; }

		public List<TicketTypeDTO> TicketTypes { get; set; } = new();
	}

	public class TicketTypeDTO
	{
		public Guid Id { get; set; }
		public string Name { get; set; } = string.Empty;
		public string? Description { get; set; }
		public bool? IsFree { get; set; }
		public int? Price { get; set; }
		public int? Quantity { get; set; }
		public AvailabilityTypeEnum Availability { get; set; }

		// SQL pre-calculates this count instead of downloading individual tracking entities
		public int RegistrationsCount { get; set; }
	}
}
