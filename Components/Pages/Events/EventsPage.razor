@page "/events"
@attribute [Authorize(Roles = "Admin")]

@using EMSWebApp.Models
@using EMSWebApp.Models.ModelEnums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components;
@using Microsoft.AspNetCore.Components.Forms;
@using Microsoft.AspNetCore.Components.Authorization;
@using Microsoft.EntityFrameworkCore

@inject EMSWebApp.Data.AppDbContext Db

@rendermode InteractiveServer

<PageTitle>Events</PageTitle>

<div class=" w-100 p-4 mb-4" style="max-width: 80rem;">
	<div class="d-flex flex-column mb-4">
		<div class="d-flex flex-row justify-content-between align-items-center w-100 mb-4">
			<div>
				<h3 class="fw-bold">Events</h3>
				<p>@eventCount events</p>
			</div>
			<div>
				<a class="btn btn-primary" href="/events/new" style="border-radius: .55rem;">New Event</a>
			</div>
		</div>
		<div class="d-flex flex-row gap-2">
			<input class="form-control flex-grow-1" placeholder="Search events..." style="border-radius: .45rem;" />

			<select @onchange="FilterChange" class="form-select" style="border-radius: .45rem; width:14rem;">
				<option value="" selected>All Status</option>
				@foreach (var items in Enum.GetValues<EventStatusEnum>())
				{
					<option value="@items">@items</option>
				}
			</select>
		</div>
	</div>

	@* show event made *@
	<div class="w-100">
		<div class="row row-cols-1 row-cols-md-3 g-3">
			@foreach (var ev in filterEvents)
			{
				<a class="col text-black text-decoration-none" style="cursor: pointer" href="/events/@ev.Id">

					<div class="hover-card border-0 card p-0 overflow-hidden" style="border-radius: 10px;">
						<div class="overflow-hidden" style="height: 10rem;">
							@if (ev.StorageUrl != "")
							{
								<img src="@ev.StorageUrl" class=" w-100" style="object-fit: cover; height:10rem;" />
							}
							else
							{
								<div class="d-flex justify-content-center align-items-center w-100 card-img-top" style="height: 10rem; background: #5296FA;">
									<svg width="36" height="37" viewBox="0 0 26 27" fill="none" xmlns="http://www.w3.org/2000/svg">
										<rect x="1" y="2.77777" width="24" height="23" rx="3" stroke="black" stroke-width="2" stroke-miterlimit="1.52425" />
										<line x1="1" y1="8.88889" x2="25" y2="8.88889" stroke="black" stroke-width="2" />
										<line x1="7" y1="1.11111" x2="7" y2="4.44445" stroke="black" stroke-width="2" stroke-linecap="round" />
										<path d="M19 1V4.55556" stroke="black" stroke-width="2" stroke-linecap="round" />
									</svg>
								</div>
							}
						</div>
						
						<div class="card-body p-3">
							<div class="d-flex flex-row justify-content-between align-items-baseline">
								<h5>@ev.Name</h5>
								<span class="badge rounded-pill @(ev.Status == EventStatusEnum.Published ? "bg-success" : "bg-secondary")">@ev.Status</span>
							</div>

							<p class="text-muted" style="font-size: .85rem;">by @ev.AppUser?.FullName</p>

							<p class="text-muted" style="font-size: .85rem;">@ev.StartDate?.ToString("dddd, MMM dd")</p>

							<p class="text-muted" style="font-size: .85rem;">Capacity: @ev.Capacity</p>
						</div>
					</div>
				</a>
			}
		</div>
	</div>
</div>


@code 
{
	private List<UserEvent> userEvents = new();
	private List<UserEvent> filterEvents = new();
	private EventStatusEnum? status;
	private int eventCount;

	protected override async Task OnInitializedAsync()
	{
		await LoadUserEvents();
		eventCount = userEvents.Count;
	}

	private async Task LoadUserEvents()
	{
		userEvents = await Db.UserEvents
								.Include(e => e.AppUser)
								.Include(e => e.Venue)
								.Take(100)
								.ToListAsync();

		filterEvents = userEvents;
	}

	private async Task ApplyFilter()
	{
		if (status == null)
		{
			// "All Status" is selected: return all events
			filterEvents = userEvents.ToList();
		}
		else
		{
			// Specific status selected: filter by enum value
			filterEvents = userEvents.Where(e => e.Status == status.Value).ToList();
		}
		StateHasChanged();
	}

	private async Task FilterChange(ChangeEventArgs e)
	{
		var rawValue = e.Value?.ToString();

		if (string.IsNullOrEmpty(rawValue))
		{
			status = null; // All Status selected
		}
		else if (Enum.TryParse<EventStatusEnum>(rawValue, out var parsedStatus))
		{
			status = parsedStatus;
		}

		await ApplyFilter();
	}
}
