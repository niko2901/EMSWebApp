	private Section3 section3Model = new Section3();

	private Vote? voteModel;

	private List<MerchPrice>? MerchPrices;

	protected override async Task OnInitializedAsync()
	{
		using var Db = await DbFactory.CreateDbContextAsync();

		MerchPrices = await Db.MerchPrices
			.AsNoTracking()
			.AsSplitQuery()
			.ToListAsync();
	}

	private async Task HandleSubmit()
	{
		try
		{
			using var Db = await DbFactory.CreateDbContextAsync();

			voteModel = new Vote
			{
				Name = section1Model.Name,
				MFeeQ1 = section1Model.MFeeQ1,
				MFeeQ2 = section1Model.MFeeQ2,

				WindQ1 = section2Model.WindQ1,
				WindQ2 = section2Model.WindQ2,

				HoodieQ1 = section2Model.HoodieQ1,
				HoodieQ2 = section2Model.HoodieQ2,

				TshirtQ1 = section2Model.TshirtQ1,
				TshirtQ2 = section2Model.TshirtQ2,

				PoloShirtQ1 = section2Model.PoloShirtQ1,
				PoloShirtQ2 = section2Model.PoloShirtQ2,

				IdnonRevQ1 = section2Model.IdnonRevQ1,
				IdnonRevQ2 = section2Model.IdnonRevQ2,

				IdRevQ1 = section2Model.IdRevQ1,
				IdRevQ2 = section2Model.IdRevQ2,

				MousePadQ1 = section2Model.MousePadQ1,
				MousePadQ2 = section2Model.MousePadQ2,

				CapQ1 = section2Model.CapQ1,
				CapQ2 = section2Model.CapQ2,

				CBLQ1 = section3Model.CBLQ1,
				CBLQ2 = section3Model.CBLQ2
			};

			Db.Votes.Add(voteModel);
			var res = await Db.SaveChangesAsync();

			if (res > 0)
			{
				isSuccess = true;
			}

		}catch (Exception ex)
		{
			errmsg = ex.Message;
		}
	}

	private void nextPage()
	{
		page++;
	}

	private void prevPage()
	{
		page--;
	}

	class Section1
	{
		public string? Name { get; set; }

		[Required(ErrorMessage = "An answer is required.")]
		public int? MFeeQ1 { get; set; }
		[Required(ErrorMessage = "An answer is required.")]
		public int? MFeeQ2 { get; set; }
	}

