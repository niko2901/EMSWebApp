		public int? TshirtQ2 { get; set; }

		// polo
		[Required]
		public int? PoloShirtQ1 { get; set; }

		[Required]
		public int? PoloShirtQ2 { get; set; }

		// Id nonreversible
		[Required]
		public int? IdnonRevQ1 { get; set; }

		[Required]
		public int? IdnonRevQ2 { get; set; }

		// Id reversible
		[Required]
