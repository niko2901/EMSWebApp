@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <AuthorizeView>
            <div class="d-flex justify-content-between top-row px-4">
                <div>@context.User.Identity?.Name</div>
                <div class="">
                    <a class="nav-link btn btn-danger text-white text-center" href="/Account/Logout">
                        Log Out
                    </a>
                </div>
            </div>
        </AuthorizeView>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
